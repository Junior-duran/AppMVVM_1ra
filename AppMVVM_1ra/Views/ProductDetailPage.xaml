<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AppMVVM_1ra.ViewModels"
             x:Class="AppMVVM_1ra.Views.ProductDetailPage"
             x:DataType="viewmodels:ProductDetailViewModel"
             Title="Detalles del Producto"
             BackgroundColor="#F5F7FA">

    <Grid>
        <!-- Actividad mientras carga -->
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" VerticalOptions="Center" Color="#0056D2" ZIndex="1"/>

        <!-- Contenido Principal -->
        <ScrollView IsVisible="{Binding CurrentProduct, Converter={StaticResource IsNotNullConverter}}">
            <VerticalStackLayout Spacing="20" Padding="20">

                <!-- Contenedor de la Imagen con sombra -->
                <Border StrokeThickness="0" BackgroundColor="White" Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Opacity="0.05" Radius="10" />
                    </Border.Shadow>

                    <Image Source="{Binding CurrentProduct.ImageUrl}" 
                           HeightRequest="300" 
                           Aspect="AspectFit" 
                           Margin="20" />
                </Border>

                <!-- Información del Producto -->
                <Label Text="{Binding CurrentProduct.Title}" FontAttributes="Bold" FontSize="22" TextColor="#333333" />

                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="{Binding CurrentProduct.Category}" TextColor="#888888" FontSize="14" TextTransform="Uppercase" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding CurrentProduct.DisplayPrice}" TextColor="#0056D2" FontAttributes="Bold" FontSize="24" />
                </Grid>

                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10" />

                <!-- Título de Descripción -->
                <Label Text="Descripción" FontAttributes="Bold" FontSize="16" TextColor="#333333" />

                <Label Text="{Binding CurrentProduct.Description}" 
                       TextColor="#555555" 
                       FontSize="15" 
                       LineHeight="1.4" />

                <!-- Espaciador para empujar el botón al fondo si es necesario -->
                <ContentView HeightRequest="20" />

                <!-- Botón de Agregar al Carrito -->
                <Button Text="Agregar al Carrito" 
                        Command="{Binding AddToCartCommand}"
                        BackgroundColor="#0056D2" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12" 
                        HeightRequest="56"
                        Margin="0,20,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#0056D2" Offset="0,6" Opacity="0.3" Radius="12" />
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>